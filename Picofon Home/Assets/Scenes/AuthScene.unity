  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Picofon \xE9s una aplicaci\xF3 educativa dissenyada per millorar la consci\xE8ncia
    fonol\xF2gica dels infants d\u2019entre 3 i 7 anys.\nL\u2019aplicaci\xF3 ha estat
    desenvolupada i gestionada pel Grup de Recerca en Cognici\xF3 i Llenguatge (UOC-UB),
    GRECIL!, format per terapeutes del llenguatge, ling\xFCistes i investigadors
    especialitzats en el desenvolupament del llenguatge infantil.\nEn continuar,
    vost\xE8 confirma que \xE9s el pare, la mare o el/la tutor/a legal de l\u2019infant
    i autoritza l\u2019\xFAs de Picofon amb finalitats exclusivament educatives i
    de recerca.\nLes dades que es recullen a trav\xE9s de l\u2019aplicaci\xF3 s\xF3n
    tractades de manera segura i confidencial. Nom\xE9s un petit conjunt d\u2019aquestes
    dades podr\xE0 ser utilitzat pels professionals del grup GRECIL! per a:\n\n\u2022
    Fer un seguiment del progr\xE9s de l\u2019infant, i/o\n\u2022 Fins cient\xEDfics
    o terap\xE8utics, sempre de forma an\xF2nima i agregada.\n\nEn cap cas les dades
    seran cedides a tercers ni utilitzades amb finalitats comercials.\nEn pr\xE9mer
    \u201CAccepto\u201D, declara haver llegit i ent\xE8s aquest av\xEDs i consentir
    el tractament de les dades segons s\u2019hi descriu.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6c9fee1c54bcaee4099e5b14c562842c, type: 2}
  m_sharedMaterial: {fileID: 4011702492835129195, guid: 6c9fee1c54bcaee4099e5b14c562842c, type: 2}
