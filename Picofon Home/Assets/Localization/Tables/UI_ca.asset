    m_Metadata:
      m_Items: []
  - m_Id: 39874476798754816
    m_Localized: "Apr\xE8n m\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 9447846335070208
    m_Localized: Selecciona un infant de la llista o registra'n un de nou.
    m_Metadata:
      m_Items: []
  - m_Id: 9448604686204928
    m_Localized: Trieu el centre on es troba el nen per continuar.
