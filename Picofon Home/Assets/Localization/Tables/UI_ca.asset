    m_Metadata:
      m_Items: []
  - m_Id: 335638120480768
    m_Localized: "Si us plau, posa el dispositiu en horitzontal per gaudir de l'experi\xE8ncia
      completa\n"
    m_Metadata:
      m_Items: []
