      m_Items: []
  - m_Id: 357328254779392
    m_Localized: Any
    m_Metadata:
      m_Items: []
  - m_Id: 357526297231360
    m_Localized: "Introdu\xEFu una data v\xE0lida"
    m_Metadata:
      m_Items: []
  - m_Id: 357653112012800
    m_Localized: A quina escola estudia?
    m_Metadata:
      m_Items: []
  - m_Id: 357841121689600
    m_Localized: 'Exemple: Bressol Chiqui La Vila'
    m_Metadata:
      m_Items: []
  - m_Id: 358083267248128
    m_Localized: Quina llengua parla?
    m_Metadata:
      m_Items: []
  - m_Id: 358595597287424
    m_Localized: En quin grau es troba?
    m_Metadata:
      m_Items: []
  - m_Id: 358917900189696
    m_Localized: "\xBFTu menor tiene alguna necesidad espec\xEDfica de apoyo educativo?"
    m_Metadata:
      m_Items: []
