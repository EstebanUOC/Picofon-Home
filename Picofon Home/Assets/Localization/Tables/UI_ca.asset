    m_Metadata:
      m_Items: []
  - m_Id: 33326841379110912
    m_Localized: Iniciar amb correu
    m_Metadata:
      m_Items: []
  - m_Id: 33331978705256448
    m_Localized: "Inicia sessi\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 33332506231259136
    m_Localized: Continua amb les teves credencials.
    m_Metadata:
      m_Items: []
  - m_Id: 33333943375970304
    m_Localized: "Correu electr\xF2nic"
    m_Metadata:
      m_Items: []
  - m_Id: 33334453139095552
    m_Localized: Contrasenya
    m_Metadata:
      m_Items: []
  - m_Id: 33334887706738688
    m_Localized: "Iniciar sessi\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 33335228867231744
    m_Localized: No tinc compte
    m_Metadata:
      m_Items: []
  - m_Id: 33336420729044992
    m_Localized: Crear compte
    m_Metadata:
      m_Items: []
  - m_Id: 33337025937752064
    m_Localized: Registra noves credencials.
    m_Metadata:
      m_Items: []
  - m_Id: 33337377420427264
    m_Localized: Confirmar contrasenya
    m_Metadata:
      m_Items: []
  - m_Id: 33337599131336704
    m_Localized: Registrar compte
    m_Metadata:
      m_Items: []
  - m_Id: 33337809110777856
    m_Localized: Ja tinc un compte
    m_Metadata:
      m_Items: []
  - m_Id: 34451304985247744
    m_Localized: "El correu electr\xF2nic no \xE9s v\xE0lid."
    m_Metadata:
      m_Items: []
  - m_Id: 34453893957140480
    m_Localized: La contrasenya no pot estar buida.
    m_Metadata:
      m_Items: []
  - m_Id: 34468129160675328
    m_Localized: "Credencials incorrectes. Revisa les teves dades o inicia sessi\xF3
      amb el mateix m\xE8tode amb qu\xE8 vas crear el teu compte. Si encara no tens
      un compte, registra't."
    m_Metadata:
      m_Items: []
  - m_Id: 34468340104806400
    m_Localized: "S'ha produ\xEFt un error de xarxa en iniciar sessi\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 34763634452414464
    m_Localized: "La contrasenya no pot estar buida o tenir menys de 6 car\xE0cters"
    m_Metadata:
      m_Items: []
  - m_Id: 34764255318458368
    m_Localized: Les contrasenyes no coincideixen.
    m_Metadata:
      m_Items: []
  - m_Id: 34791044925308928
    m_Localized: "S'ha produ\xC3\xAFt un error de xarxa en registrar l'usuari."
    m_Metadata:
      m_Items: []
  - m_Id: 34791403248893952
    m_Localized: "Aquest correu ja t\xE9 una compte associat."
    m_Metadata:
      m_Items: []
  - m_Id: 40204140486443008
    m_Localized: "Molt b\xE9! Has acabat totes les activitats. \nHo has fet genial!"
    m_Metadata:
      m_Items: []
