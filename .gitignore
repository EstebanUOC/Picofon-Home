# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
UserSettings/

# Firebase / SDK binaries (too big for GitHub)
*.bundle
*.aar
*.dll
*.so
*.jar

# Autogenerated VS/JetBrains files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.pdb
*.mdb
*.opendb

# OS generated files
.DS_Store
Thumbs.db

# Unity cache and temporary files
*.bak
*.backup
*.cache

# Crash Reports
sysinfo.txt

# Git LFS tracked files (optional; also run `git lfs track`)
*.psd
*.fbx
*.mp4
*.mp3
*.blend
*.tga
*.gif

# Build artifacts
*.apk
*.aab
*.exe
*.app
*.unitypackage

# Ignore Google Drive temporary upload folders
*.tmp.driveupload/
.tmp.driveupload/
*/.tmp.driveupload/

# Configuration files
*.ini

# Generated by Unity when building for iOS/Android/Xcode etc.
ExportedObj/
*.svd

# Build results
*/Build/

# Ignorar carpetas generadas por Burst u otras herramientas de build
**/*BurstDebugInformation_DoNotShip*/
*BurstDebugInformation_DoNotShip*/

# Unity Addressables
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# Unity specific meta files to ignore (keep most .meta files for Unity references)
*.pidb.meta
*.pdb.meta
*.mdb.meta
