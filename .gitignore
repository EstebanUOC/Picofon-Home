# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
UserSettings/

# Firebase / SDK binaries (too big for GitHub)
*.bundle
*.aar
*.dll
*.so
*.jar

# Autogenerated VS/JetBrains files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.pdb
*.mdb
*.opendb
*.DS_Store
Thumbs.db

# Unity cache
*.bak
*.backup
*.cache
*.pidb.meta

# OS generated files
.DS_Store
Thumbs.db

# Crash Reports
sysinfo.txt

# Git LFS tracked files (optional; also run `git lfs track`)
*.psd
*.fbx
*.mp4
*.wav
*.mp3
*.blend
*.tga
*.gif

# Build artifacts
*.apk
*.aab
*.exe
*.app
*.unitypackage

# Ignore Google Drive temporary upload folders
*.tmp.driveupload/
.tmp.driveupload/
*/.tmp.driveupload/

# Ignore PNGs globally except for this folder
*.png
!Picofon Home/Assets/Images/**/*.png

# Ignore local image folders (synced with Google Drive)
"Picofon Home/Assets/Resources/Images/"
"Picofon Home/Assets/Resources/Images/ImgButtons/"

# Ignore all Unity meta files
*.meta
*.ini

# Generated by Unity when building for iOS/Android/Xcode etc.
ExportedObj/
*.pidb
*.svd
*.pdb

# Build results
*/Build/

# Ignorar carpetas generadas por Burst u otras herramientas de build
**/*BurstDebugInformation_DoNotShip*/
*BurstDebugInformation_DoNotShip*/
